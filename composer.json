{
  "name": "mrcaspan/flarum2-events-calendar",
  "description": "Events calendar for Flarum 2.0: discussions in an events tag get a date and appear on a calendar, with an attendee list, wait list, RSVP and \"schedule next\". All wording (Event, Attendee, Spot) is set by the admin.",
  "keywords": [
    "flarum",
    "flarum2",
    "extension",
    "calendar",
    "events",
    "rsvp",
    "attendees",
    "meetups"
  ],
  "type": "flarum-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "MrCaspan",
      "homepage": "https://github.com/MrCaspan"
    }
  ],
  "support": {
    "issues": "https://github.com/MrCaspan/flarum2-events-calendar/issues",
    "source": "https://github.com/MrCaspan/flarum2-events-calendar"
  },
  "require": {
    "flarum/core": "^2.0",
    "flarum/tags": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "MrCaspan\\EventsCalendar\\": "src/"
    }
  },
  "extra": {
    "flarum-extension": {
      "title": "Events Calendar",
      "category": "feature",
      "icon": {
        "name": "fas fa-calendar-alt",
        "backgroundColor": "#1f8c4f",
        "color": "#fff"
      }
    }
  }
}
